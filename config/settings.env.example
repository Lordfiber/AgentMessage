# Kafka 集群引导地址（host:port）
KAFKA_BOOTSTRAP=192.168.1.10:9092

# 当前 worker 标识
WORKER_ID=worker-B
# worker 角色（如 实现工程师、审查工程师 等）
WORKER_ROLE=实现工程师

# 轮询间隔（分钟）
POLL_MIN=2

# TRAE 引擎类型（cli / api）
TRAE_ENGINE=cli
# TRAE CLI 可执行文件路径
TRAE_CLI_PATH=trae-cli

# 运行时根目录（相对路径将基于 process.cwd() 解析为绝对路径）
RUNTIME_DIR=./runtime

# 死信队列目录
DLQ_DIR=./runtime/state/_dlq

# 已处理消息记录文件
PROCESSED_FILE=./runtime/state/processed.jsonl

# worker 进程锁文件
WORKER_LOCK=./runtime/state/worker.lock

# Agent 完成 Hook 黑盒后端地址（每个 agent 任务完成后 POST 详情到此处）
# 留空则 no-op；黑盒实现自定（审计/监控/BI/数据仓库 皆可）
AGENT_HOOK_URL=http://192.168.1.10:8080/agent-hook/complete
